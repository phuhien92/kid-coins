# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database — runtime (Vercel/serverless): Transaction pooler, port 6543, IPv4
# Copy from Supabase Dashboard → Connect → Transaction pooler (NOT the direct :5432 URL)
# Username must be postgres.<project-ref> (e.g. postgres.umdmjgjugywsuzyeuvvy), not plain postgres
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Migrations only (local): direct connection, port 5432 — do NOT use this as Vercel DATABASE_URL
# export DATABASE_URL='postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres'
# pnpm db:migrate:prod

# Anthropic (AI Coach)
ANTHROPIC_API_KEY=sk-ant-...

# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
