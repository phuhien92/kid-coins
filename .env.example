# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Supabase Postgres connection string — use transaction pooler for serverless)
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Anthropic (AI Coach)
ANTHROPIC_API_KEY=sk-ant-...

# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Cron (savings-jar interest accrual) — shared secret sent as
# `Authorization: Bearer <CRON_SECRET>` by the weekly scheduler
CRON_SECRET=your-cron-secret
